    "receipts",
    "disbursements",
    "cash_on_hand_end",
    "debts_owed",
    "coverage_start",
    "coverage_end",
    "fec_candidate_id"
  ],
  "properties": {
    "type": { "const": "finance" },
    "cycle": { "type": "integer" },
    "receipts": { "type": "number" },
    "disbursements": { "type": "number" },
    "cash_on_hand_end": { "type": "number" },
    "debts_owed": { "type": "number" },
    "coverage_start": { "type": "string", "format": "date" },
    "coverage_end": { "type": "string", "format": "date" },
    "fec_candidate_id": { "type": "string" }
