{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/OWNER/political-tracker/schemas/base.schema.json",
  "title": "Base record",
  "description": "Fields every record carries. Type schemas add their own fields and restrict additional properties.",
  "type": "object",
  "required": [
    "id",
    "type",
    "candidate_ids",
    "source_url",
    "published_at",
    "collected_at",
    "collector",
    "topics"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "type": {
      "type": "string"
    },
    "candidate_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      }
    },
    "source_url": {
      "type": "string",
      "format": "uri"
    },
    "archive_url": {
      "type": ["string", "null"],
      "format": "uri"
    },
    "published_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}"
    },
    "collected_at": {
      "type": "string",
      "format": "date-time"
    },
    "collector": {
      "type": "string",
      "pattern": "^([a-z0-9_]+@\\d+\\.\\d+|manual)$"
    },
    "tagged_by": {
      "type": "string"
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
