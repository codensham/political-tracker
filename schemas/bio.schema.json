{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bio record (type-specific fields)",
  "description": "One office held, education entry, or career entry for a candidate. Judgment tier: reviewed before merge. Composed with base.schema.json by tracker.validate.",
  "type": "object",
  "required": ["kind", "title", "organization", "start_date", "end_date", "location"],
  "properties": {
    "type": { "const": "bio" },
    "kind": { "type": "string", "enum": ["office", "education", "career"] },
    "title": { "type": "string", "minLength": 1 },
    "organization": { "type": "string", "minLength": 1 },
    "start_date": { "type": ["string", "null"], "format": "date" },
    "end_date": { "type": ["string", "null"], "format": "date" },
    "location": { "type": ["string", "null"] }
  }
}
