{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Appearance record (type-specific fields)",
  "description": "A public event where the candidate appeared. Judgment tier. Composed with base.schema.json by tracker.validate.",
  "type": "object",
  "required": ["event", "venue", "host", "date", "transcript_url", "video_url"],
  "properties": {
    "type": { "const": "appearance" },
    "event": { "type": "string", "minLength": 1 },
    "venue": { "type": ["string", "null"] },
    "host": { "type": ["string", "null"] },
    "date": { "type": "string", "format": "date" },
    "transcript_url": { "type": ["string", "null"], "format": "uri" },
    "video_url": { "type": ["string", "null"], "format": "uri" }
  }
}
